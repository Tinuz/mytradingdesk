{
  "name": "crypto-macro-intelligence-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@cmip/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.json",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:migrations": "vitest run tests/migrations",
    "smoke:providers": "vite-node tests/smoke/coingecko.ts",
    "smoke:global-liquidity": "vite-node tests/smoke/global-liquidity.ts",
    "smoke:dollar-strength": "vite-node tests/smoke/dollar-strength.ts",
    "ingest:live": "vite-node scripts/ingest-live.ts",
    "ingest:v3-live": "vite-node scripts/ingest-v3-live.ts",
    "derive:v3": "vite-node scripts/derive-v3-indicators.ts",
    "backfill:phase2": "vite-node scripts/backfill-phase2.ts",
    "backfill:phase3": "vite-node scripts/backfill-phase3.ts",
    "backfill:dollar-strength": "vite-node scripts/backfill-dollar-strength.ts",
    "audit:dollar-strength": "vite-node scripts/audit-dollar-strength.ts",
    "backfill:crypto-credit": "vite-node scripts/backfill-crypto-credit.ts",
    "audit:crypto-credit": "vite-node scripts/audit-crypto-credit.ts",
    "backfill:market-structure": "vite-node scripts/backfill-market-structure.ts",
    "audit:market-structure": "vite-node scripts/audit-market-structure.ts",
    "sync:quarantine-events": "vite-node scripts/sync-quarantine-events.ts",
    "evaluate:v3-regimes": "vite-node scripts/evaluate-v3-regimes.ts",
    "evaluate:v3-decisions": "vite-node scripts/evaluate-v3-decisions.ts",
    "alerts:live": "vite-node scripts/process-alerts.ts --live",
    "alerts:historical": "vite-node scripts/process-alerts.ts --historical",
    "trust:capture": "vite-node scripts/capture-trust-observation.ts",
    "portfolio:snapshot": "vite-node scripts/capture-portfolio-snapshots.ts",
    "portfolio:lots": "vite-node scripts/calculate-tax-lots.ts",
    "valuations:calculate": "vite-node scripts/calculate-valuations.ts",
    "intelligence:calculate": "vite-node scripts/calculate-investment-intelligence.ts",
    "governance:review-source": "vite-node scripts/review-source-governance.ts",
    "connectors:sync-read-only": "vite-node scripts/sync-read-only-connector.ts",
    "allocations:calculate": "vite-node scripts/calculate-allocations.ts",
    "portfolio:risk": "vite-node scripts/calculate-portfolio-risk.ts",
    "capital:assess": "vite-node scripts/assess-capital-readiness.ts",
    "paper:run": "vite-node scripts/run-paper-portfolio.ts",
    "performance:calculate": "vite-node scripts/calculate-performance-analytics.ts",
    "outcomes:calculate": "vite-node scripts/calculate-recommendation-outcomes.ts",
    "validation:monthly-report": "vite-node scripts/generate-monthly-validation-report.ts",
    "validation:replay": "vite-node scripts/run-validation-replay.ts",
    "validation:audit-point-in-time": "vite-node scripts/audit-point-in-time.ts",
    "shadow:cycle": "vite-node scripts/run-shadow-cycle.ts",
    "v1:assess": "vite-node scripts/assess-v1-gates.ts",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "postgres": "^3.4.7",
    "prettier": "^3.9.9",
    "typescript": "^5.8.0",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.0"
  }
}
