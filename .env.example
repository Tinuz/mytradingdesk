# Copy to .env.local (ignored by git) and fill in the values you need.
# Only NEXT_PUBLIC_* values may reach the browser; everything else is server-only.

# --- Supabase (required for the web app and every script) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Market data providers (daily shadow cycle and backfills) ---
FRED_API_KEY=
TWELVE_DATA_API_KEY=
# Optional: only needed when the CoinGecko plan requires a key.
COINGECKO_API_KEY=
SOSOVALUE_API_KEY=
COINALYZE_API_KEY=

# --- Optional email alerts via Resend (sender domain must be verified) ---
RESEND_API_KEY=
ALERT_EMAIL_FROM=

# --- Optional: direct PostgreSQL URL for the database smoke test ---
CMIP_DB_URL=
